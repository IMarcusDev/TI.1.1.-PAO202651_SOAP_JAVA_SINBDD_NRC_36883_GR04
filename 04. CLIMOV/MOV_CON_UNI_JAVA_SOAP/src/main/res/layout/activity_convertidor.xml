<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/barraSuperior"
        style="@style/Barra">

        <TextView
            style="@style/Barra.Titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/app_titulo" />

        <Button
            android:id="@+id/btnCerrarSesion"
            style="@style/Boton.Texto.Claro"
            android:layout_marginStart="8dp"
            android:text="@string/conv_cerrar_sesion" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conv_magnitud"
                android:textSize="16sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="-20dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/grpMagnitud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/panel_fondo"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/txtValor"
                    android:text="@string/conv_desde" />

                <EditText
                    android:id="@+id/txtValor"
                    style="@style/Texto.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@null"
                    android:hint="@string/conv_valor"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned"
                    android:minHeight="56dp"
                    android:singleLine="true"
                    android:textColorHint="@color/contorno"
                    android:textSize="36sp" />

                <Spinner
                    android:id="@+id/spnOrigen"
                    style="@style/Selector"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnIntercambiar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="-16dp"
                android:layout_marginBottom="-16dp"
                android:background="@drawable/intercambiar_fondo"
                android:contentDescription="@string/conv_intercambiar"
                android:elevation="2dp"
                android:outlineProvider="none"
                android:scaleType="center"
                android:src="@drawable/ic_intercambiar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_resultado_fondo"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/conv_hacia"
                    android:textColor="@color/sobre_azul_suave" />

                <Spinner
                    android:id="@+id/spnDestino"
                    style="@style/Selector.Resultado"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/lblResultado"
                    style="@style/Texto.Display"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:autoSizeMaxTextSize="44sp"
                    android:autoSizeMinTextSize="24sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="@string/conv_sin_resultado"
                    android:textColor="@color/sobre_azul"
                    android:textIsSelectable="true"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/lblDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/conv_instruccion"
                    android:textColor="@color/sobre_azul_suave"
                    android:textSize="14sp" />

                <ec.edu.monster.vista.ReglaVista
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="16dp"
                    android:importantForAccessibility="no"
                    app:colorMarca="@color/azul_marca"
                    app:mostrarNumeros="false" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/prgCargando"
                style="@style/Progreso"
                android:layout_marginTop="12dp"
                android:visibility="invisible" />

            <Button
                android:id="@+id/btnConvertir"
                style="@style/Boton.Primario"
                android:layout_marginTop="8dp"
                android:text="@string/conv_convertir" />

            <TextView
                android:id="@+id/lblError"
                style="@style/Aviso.Error"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
