<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Texto.Display" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tinta</item>
        
    </style>

    <style name="Texto.Etiqueta" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tinta</item>
    </style>

    <style name="Campo" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/campo_fondo</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:textColorHint">@color/tinta_suave</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Selector" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/selector_fondo</item>
        <item name="android:popupBackground">@drawable/desplegable_fondo</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">44dp</item>
        <item name="android:dropDownVerticalOffset">56dp</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>

    <style name="Selector.Resultado">
        <item name="android:background">@drawable/selector_resultado_fondo</item>
    </style>

    <style name="Boton.Primario" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/boton_primario_fondo</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/boton_primario_texto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Boton.Texto" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/boton_texto_fondo</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Boton.Texto.Claro">
        <item name="android:background">@drawable/boton_claro_fondo</item>
        <item name="android:textColor">@color/sobre_azul</item>
    </style>

    <style name="Barra" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@color/azul</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Barra.Titulo" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/sobre_azul</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/chip_fondo</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/chip_texto</item>
    </style>

    <style name="Aviso.Error" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/aviso_error_fondo</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>

    <style name="Progreso" parent="android:Widget.Material.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateTint">@color/azul</item>
    </style>
</resources>
